{
  "name": "ana-atendente-virtual",
  "version": "1.0.0",
  "description": "Ana — Atendente virtual de agendamento via WhatsApp + ERP interno",
  "main": "dist/webhookServer.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/webhookServer.js",
    "dev": "ts-node-dev --respawn --transpile-only src/webhookServer.ts",
    "smoke:security": "node scripts/smoke-security.ts",
    "smoke:booking-reasons": "npx tsx scripts/smoke-booking-reasons.ts",
    "smoke:service-gate": "node scripts/smoke-service-gate.ts",
    "smoke:debounce-flush": "ts-node scripts/smoke-debounce-flush-error.ts",
    "smoke:scrub-message": "ts-node -T scripts/smoke-ana-scrub-message.ts",
    "smoke:erp-token": "ts-node -T scripts/smoke-erp-api-token.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.55.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.0",
    "openai": "^4.52.7",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.20.0",
    "chokidar": "^3.6.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
