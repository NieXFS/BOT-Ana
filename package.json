    "express": "^4.19.0",
    "openai": "^4.52.7",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.20.0",
    "chokidar": "^3.6.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
