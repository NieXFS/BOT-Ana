# --- Banco de dados -----------------------------------------------------------
# OBRIGATÓRIO. Context manager (ana_conversation_history) usa Postgres direto via
# pg. Sem ele a Ana lança erro no boot (src/services/contextManager.ts).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/receps_erp?sslmode=require

# --- OpenAI -------------------------------------------------------------------
OPENAI_API_KEY=sk-replace-with-openai-api-key
# Opcionais (têm default no código). Modelo padrão: gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
# Temperatura padrão: 0.4
OPENAI_TEMPERATURE=0.4
# Máx. de tokens por resposta. Padrão: 500
OPENAI_MAX_TOKENS=500

# --- DeepSeek (Ana recepcionista, opcional) ----------------------------------
# Só é usado quando o BotConfig do tenant traz aiProvider="deepseek" e
# aiModel="deepseek-v4-flash". Não há fallback silencioso para OpenAI.
DEEPSEEK_API_KEY=sk-replace-with-deepseek-api-key
# Hard gate independente da chave. Em NODE_ENV=production, deve permanecer
# false até aprovação de governança/LGPD, mecanismo de transferência e
# atualização da lista pública de subprocessadores.
DEEPSEEK_PRODUCTION_APPROVED=false
# Apenas para o modo legado por ENV. No multi-tenant o modelo vem do Receps.
AI_PROVIDER=openai
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Meta / WhatsApp Cloud API ------------------------------------------------
WA_PHONE_NUMBER_ID=replace-with-phone-number-id
WA_BUSINESS_ACCOUNT_ID=replace-with-business-account-id
WA_ACCESS_TOKEN=replace-with-wa-access-token
WA_VERIFY_TOKEN=replace-with-verify-token
# Token de verificação global (multi-tenant). Tem precedência sobre WA_VERIFY_TOKEN
# no GET /webhook (src/webhookServer.ts). Opcional — se vazio, cai no WA_VERIFY_TOKEN.
WA_GLOBAL_VERIFY_TOKEN=replace-with-global-verify-token
WA_API_VERSION=v21.0
# App Secret do app da Meta. OBS: a verificação da assinatura X-Hub-Signature-256
# da Meta acontece no INBOUND do Receps (/api/v1/bot/webhook), não aqui — a Ana
# recebe o payload já encaminhado pelo Receps e valida o X-Bot-Signature do
# forward (ver RECEPS_BOT_WEBHOOK_SECRET abaixo). Mantido por compatibilidade.
META_APP_SECRET=
WHATSAPP_APP_SECRET=

# --- Servidor -----------------------------------------------------------------
PORT=5001
NODE_ENV=development

# --- Comportamento do bot (opcionais, com default no código) ------------------
# Nome usado nas respostas. Padrão: DEFAULT_BOT_NAME (src/configProvider.ts).
BOT_NAME=
# Mensagem de saudação. Padrão: DEFAULT_GREETING_MESSAGE.
GREETING_MESSAGE=
# Mensagem de fallback. Padrão: DEFAULT_FALLBACK_MESSAGE.
FALLBACK_MESSAGE=
# Se "true", o bot responde 24h ignorando a janela horária. Padrão: false.
BOT_IS_ALWAYS_ACTIVE=false
# Janela de atendimento (HH:MM 24h). Padrões: 08:00 / 20:00.
BOT_ACTIVE_START=08:00
BOT_ACTIVE_END=20:00

# Poller da régua de follow-up da Renata, em ms. Default: 30min (1800000).
# Em produção, valores menores que 10min (600000) são elevados ao piso com aviso.
SALES_FOLLOWUP_POLL_MS=1800000

# --- Renata: resposta por nota de voz (só botRole=sales) ----------------------
# Kill-switch. "true" liga o pipeline de voz. Default OFF (Renata responde texto).
RENATA_VOICE_ENABLED=false
# Provider primário. Default do código: elevenlabs; só mudar após gate auditivo.
RENATA_TTS_PROVIDER=elevenlabs
# Gemini TTS (HTTP direto; não reutiliza GEMINI_MODEL de chat).
GEMINI_API_KEY=
RENATA_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
RENATA_GEMINI_TTS_VOICE=Achernar
RENATA_GEMINI_TTS_TEMPERATURE=1.1
RENATA_GEMINI_TTS_STYLE_PROMPT=Fale de forma empática, ritmo rápido, sotaque neutro do português brasileiro
# Se prefix fizer a instrução vazar no áudio, troque para system sem mudar código.
RENATA_GEMINI_TTS_STYLE_MODE=prefix
# Teto diário de chars Gemini (alarme de custo em 80%; não desliga a voz).
RENATA_GEMINI_TTS_DAILY_CHAR_BUDGET=100000
# ElevenLabs (também é o fallback automático quando Gemini falha em runtime).
RENATA_ELEVENLABS_API_KEY=
RENATA_ELEVENLABS_VOICE_ID=x8FWrDHAK5xiFTJLpnHq
# "Carla". flash_v2_5 REPROVADO de ouvido — não trocar sem novo teste.
RENATA_TTS_MODEL=eleven_multilingual_v2
# Parâmetros afinados de ouvido pelo Victor em 2026-07-23.
# style > 0 aumenta um pouco a latência/custo computacional; trade-off aceito.
RENATA_TTS_STABILITY=0.40
RENATA_TTS_SIMILARITY=0.75
RENATA_TTS_SPEED=1.13
RENATA_TTS_STYLE=0.10
# Teto DIÁRIO de chars sintetizados (só conta MISS de cache; alarme Sentry em 80%).
# É por DIA, não por mês: Creator 100k/mês ÷ 30 ≈ 3300; Pro 500k/mês ÷ 30 ≈ 16000.
RENATA_TTS_DAILY_CHAR_BUDGET=3300
# Acima disso a resposta vai por TEXTO. ~600 ≈ 40–45s.
RENATA_VOICE_MAX_CHARS=600

# --- ERP / Agenda -------------------------------------------------------------
ERP_BASE_URL=http://localhost:3000
# OBRIGATÓRIO EM PRODUÇÃO. Token Bearer que a Ana usa para autenticar na API
# interna do Receps. DEVE ter o MESMO valor do ERP_API_TOKEN no .env do Receps.
# Sem ele em produção a Ana LANÇA no boot (src/erpApiToken.ts) e o PM2 não sobe
# (fail-fast) — nunca mais cai num default público. Em dev, gera um token
# efêmero aleatório (chamadas ao Receps dão 401, ok localmente).
ERP_API_TOKEN=replace-with-erp-api-token
ERP_TENANT_SLUG=clinica-bella
TIMEZONE=America/Sao_Paulo

# --- Receps internal API (opt-out etc.) ---------------------------------------
RECEPS_INTERNAL_API_URL=http://localhost:3000
# Segredo HMAC do forward Receps→Ana (header X-Bot-Signature). DEVE ter o MESMO
# valor do RECEPS_BOT_WEBHOOK_SECRET no .env do Receps. Em produção é
# obrigatório: sem ele o POST /webhook responde 503 (fail-closed). A assinatura
# da Meta é verificada no inbound do Receps, não aqui.
RECEPS_BOT_WEBHOOK_SECRET=replace-with-bot-webhook-secret

# --- Sentry (observabilidade) -------------------------------------------------
# DSN do Sentry da Ana. Sem ele o SDK fica em no-op silencioso (nada é enviado).
ANA_SENTRY_DSN=
# Release reportada (ex.: SHA do git ou versão do deploy). Opcional.
ANA_RELEASE=
# Ambiente reportado (dev/staging/prod). Opcional — padrão: NODE_ENV.
ANA_SENTRY_ENVIRONMENT=
